# Contact form (app/api/contact/route.ts) — sends mail through Resend (https://resend.com).
# Copy to .env.local for local development; set the same names in Netlify > Site configuration > Environment variables (scope: Functions/Runtime).
RESEND_API_KEY=
# Inbox that receives the messages
CONTACT_TO_EMAIL=
# Verified sender, e.g. "Portafolio <contacto@your-domain.com>" (use onboarding@resend.dev while testing)
CONTACT_FROM_EMAIL=
